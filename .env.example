OPENROUTER_API_KEY=your-api-key-here

# Optional. Cheap model for the one-shot explain button on a flashcard.
EXPLAIN_MODEL=google/gemini-2.5-flash

# Optional. Stronger model for generated lessons and decks, which are long
# enough to be worth it. Any OpenRouter model id works.
LESSON_MODEL=anthropic/claude-sonnet-5
